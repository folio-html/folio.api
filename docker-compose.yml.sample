name: folio-api

# Copy this to docker-compose.yml and adjust to your environment.
# Put a reverse proxy (Traefik, nginx, Caddy, …) in front for TLS and routing.

services:
  folio-api:
    build: .
    image: folio-api:latest
    container_name: folio-api
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      # Required: the login password clients exchange for a session cookie. Set it
      # in a .env file next to this compose file (FOLIO_PASSWORD=...) or in the
      # shell environment.
      - Folio__Password=${FOLIO_PASSWORD:?FOLIO_PASSWORD must be set}
      - Folio__DataDir=/data
      # If the frontend is served from a DIFFERENT origin than this API, list
      # its origin(s) so CORS allows it. Not needed for the same-origin mount
      # below. ASP.NET binds array items via indexed keys:
      # - Folio__AllowedOrigins__0=https://folio.example.com
    volumes:
      # Journals + backups persist here.
      - ./data:/data
      # Serve the frontend same-origin from a sibling clone of folio.html. Mount
      # the DIRECTORY, not the file: a single-file bind mount pins the old inode,
      # so a `git pull` there would keep serving stale content until a restart.
      - ../folio.html/public:/app/wwwroot:ro
